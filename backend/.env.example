PORT=4000
NODE_ENV=development

# PostgreSQL
DATABASE_URL=postgres://postgres:postgres@localhost:5432/yessica

# JWT
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS — the Angular dev server origin
CORS_ORIGIN=http://localhost:4200

# Seeded on first `npm run seed` (change the password immediately after)
ADMIN_EMAIL=admin@yessicasalon.com
ADMIN_PASSWORD=change-me-now

# Google Places — pulls the real rating, review count and reviews shown in the
# hero and the Google Reviews section. Get a key at
# https://console.cloud.google.com/apis/credentials with the "Places API" enabled.
# Leave blank to keep the [4.x] / [00] placeholders.
GOOGLE_PLACES_API_KEY=
# Optional: skip the name lookup by pasting the Place ID directly
# (find it at https://developers.google.com/maps/documentation/places/web-service/place-id).
GOOGLE_PLACE_ID=
# Used only if GOOGLE_PLACE_ID is blank, to look the business up by name.
GOOGLE_PLACE_QUERY=YESSICA Unisex Salon, Karimugal, Kochi
